# Example environment variables
PORT=5000
MONGO_URI=mongodb://localhost:27017/ai_chatbot_demo
# MongoDB connection string (replace with your DB URI). For local dev use:
# MONGO_URI=mongodb://localhost:27017/ai_chatbot_demo
# If using MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_chatbot_demo?retryWrites=true&w=majority
# If using OpenAI set:
# OPENAI_API_KEY=your_api_key_here
